// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  description String?
  apiKey      String   @unique @default(cuid())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rateLimits RateLimit[]
  apiLogs    ApiLog[]

  @@index([apiKey])
}

enum RateLimitType {
  GENERAL    // Apply to all requests from tenant
  IP         // Apply per IP address
  API        // Apply per API endpoint
  USER       // Apply per user ID
}

model RateLimit {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  type        RateLimitType @default(GENERAL)
  
  // Rate limit configuration
  maxRequests Int           @default(100)  // Maximum requests allowed
  windowMs    Int           @default(60000) // Time window in milliseconds (default: 1 minute)
  
  // Optional: specific to API type
  apiPath     String?       // e.g., "/api/users", null for non-API types
  
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([type])
}

model ApiLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  apiUrl      String
  ipAddress   String?
  userId      String?
  
  success     Boolean  @default(true)
  statusCode  Int?
  rateLimited Boolean  @default(false)
  
  timestamp   DateTime @default(now())

  @@index([tenantId])
  @@index([timestamp])
  @@index([rateLimited])
}
